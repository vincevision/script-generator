# ─── EPIC WEAR store configuration ────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env — it holds your secrets.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public URL of the store (used for canonical links, sitemap, OG tags, M-PESA callback)
SITE_URL=http://localhost:3000
# Where the SQLite database and uploaded images live
DATA_DIR=data
# Set to true when running behind a reverse proxy / load balancer (Render, Railway, Nginx…)
TRUST_PROXY=true
# Allow the store to be embedded in iframes (defaults to on in development only)
# ALLOW_FRAMING=false

# ─── Admin bootstrap ──────────────────────────────────────────────────────
# On start-up an admin account is created for this email if it does not exist.
# Use a long, unique password (10+ characters). You can also run:
#   npm run create-admin -- you@example.com "long-password"
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_DAYS=30

# ─── M-PESA (Safaricom Daraja — Lipa Na M-PESA Online / STK Push) ─────────
# Get these from https://developer.safaricom.co.ke (sandbox first, then Go Live).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill or Till (Head Office) shortcode, and the Lipa Na M-PESA Online passkey
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till number)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For Till numbers, the till number receiving funds (defaults to MPESA_SHORTCODE)
MPESA_PARTY_B=
# Public HTTPS base URL Safaricom can reach (defaults to SITE_URL)
MPESA_CALLBACK_BASE=
# Long random string — part of the secret callback URL. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=

# Without M-PESA credentials a local payment simulator runs in development
# (phone ending 000 = cancelled, 111 = insufficient funds, anything else = paid).
# It is disabled in production unless you force it for a staging demo:
# PAYMENTS_SIMULATE=false
